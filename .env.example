# ==============================================================================
# KERTAGOSA - Environment Variables Configuration
# Kejaksaan Negeri Klungkung
# ==============================================================================

# Vercel Blob Cloud Storage Read/Write Token
# Dapatkan token dari: Vercel Dashboard -> Storage -> Blob -> Settings
# Format resmi: vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxxxx
BLOB_READ_WRITE_TOKEN=

# JWT Secret Key (Optional: jika tidak diset, sistem menghasilkan random secret)
JWT_SECRET=kertagosa-adhyaksa-klungkung-secret-key-2026

# Server Port (Default: 8000)
PORT=8000
